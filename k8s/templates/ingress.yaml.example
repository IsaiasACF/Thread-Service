apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: thread-api
  namespace: grupo-threads
spec:
  ingressClassName: traefik
  rules:
  - host: PENDING_PUBLIC_HOST
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: thread-api
            port:
              number: 8000
